# ============================================================
# AI YouTube Shorts Generator — Local Mode Configuration
# ============================================================
# By default, everything runs locally with Ollama. No API keys needed!

# LLM Provider (default: ollama — fully local, no API key)
LLM_PROVIDER=ollama

# Ollama settings (default, fully local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Whisper settings (local speech-to-text)
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# ============================================================
# OPTIONAL: Cloud API providers (only if you prefer them)
# ============================================================
# Uncomment and fill in ONLY if you want to use cloud LLMs instead of Ollama.

# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# OPTIONAL: MuAPI (only for --mode api)
# ============================================================
# MUAPI_API_KEY=your_muapi_key_here
